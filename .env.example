POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tripmind_trips
POSTGRES_HOST=postgres
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/tripmind_trips
LOCAL_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/tripmind_trips

AUTH_DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/tripmind_auth
LOCAL_AUTH_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/tripmind_auth

JWT_SECRET_KEY=tripmind-super-secret-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
LOCAL_REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://redis:6379/1
LOCAL_CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
LOCAL_CELERY_RESULT_BACKEND=redis://localhost:6379/2
REPORTS_DIR=/app/reports

# Task 14 — Microservice-to-Microservice Communication
# Trip Service → Auth Service HTTP client settings
AUTH_SERVICE_URL=http://auth-service:8000
AUTH_HTTP_TIMEOUT=5.0
AUTH_HTTP_MAX_RETRIES=3
AUTH_HTTP_BACKOFF_FACTOR=0.5


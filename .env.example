POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tripmind_trips
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/tripmind_trips
LOCAL_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/tripmind_trips

# Frontend (client)
CLIENT_PORT=5173
# Set to true if file changes aren't picked up (e.g. Docker Desktop on macOS/Windows).
VITE_USE_POLLING=false

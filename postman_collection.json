{
  "info": {
    "name": "TripMind - Full Microservices API",
    "description": "API collection for TripMind Auth Service and Trip Service microservices",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "tripBaseUrl",
      "value": "http://localhost:8001",
      "type": "string"
    },
    {
      "key": "authBaseUrl",
      "value": "http://localhost:8002",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "tripId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth Service (Port 8002)",
      "item": [
        {
          "name": "Auth Health Check",
          "request": {
            "method": "GET",
            "url": "{{authBaseUrl}}/health"
          }
        },
        {
          "name": "1. Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"traveler@tripmind.com\",\n  \"password\": \"securepassword123\"\n}"
            },
            "url": "{{authBaseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "2. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.access_token);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"traveler@tripmind.com\",\n  \"password\": \"securepassword123\"\n}"
            },
            "url": "{{authBaseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "3. Get Current User (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{authBaseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "4. Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.access_token);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{authBaseUrl}}/api/v1/auth/refresh"
          }
        }
      ]
    },
    {
      "name": "Trip Service (Port 8001)",
      "item": [
        {
          "name": "Trip Health Check",
          "request": {
            "method": "GET",
            "url": "{{tripBaseUrl}}/health"
          }
        },
        {
          "name": "1. Create Trip (Authenticated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('tripId', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Swiss Winter Adventure\",\n  \"destination\": \"Interlaken, Switzerland\",\n  \"start_date\": \"2026-12-01\",\n  \"end_date\": \"2026-12-10\",\n  \"budget\": 4200.00\n}"
            },
            "url": "{{tripBaseUrl}}/api/v1/trips"
          }
        },
        {
          "name": "2. Get My Trips (Authenticated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{tripBaseUrl}}/api/v1/trips"
          }
        },
        {
          "name": "3. Get Public / All Trips (Unauthenticated)",
          "request": {
            "method": "GET",
            "url": "{{tripBaseUrl}}/api/v1/trips"
          }
        },
        {
          "name": "4. Get Trip By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{tripBaseUrl}}/api/v1/trips/{{tripId}}"
          }
        },
        {
          "name": "5. Update Trip (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"budget\": 4900.00\n}"
            },
            "url": "{{tripBaseUrl}}/api/v1/trips/{{tripId}}"
          }
        },
        {
          "name": "6. Delete Trip",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{tripBaseUrl}}/api/v1/trips/{{tripId}}"
          }
        }
      ]
    }
  ]
}
